# =============================================================================
# KOFFRA API — exemple de configuration. NE JAMAIS y mettre de vraies valeurs.
# Copier vers .env puis lancer : php artisan key:generate
# =============================================================================

APP_NAME=KOFFRA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origine(s) du frontend autorisée(s) par CORS (séparées par des virgules)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Aucun secret ne doit jamais être journalisé. En production : LOG_LEVEL=warning
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Développement local rapide : sqlite. Cible (dev Docker / Hostinger) : mysql 8.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=koffra
# DB_USERNAME=koffra
# DB_PASSWORD=

# Sessions : cookie HttpOnly, chiffré. En production : SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Domaines (host:port) autorisés pour l'authentification Sanctum par cookie
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Hostinger mutualisé : pas de worker permanent → queue "database" traitée par cron
QUEUE_CONNECTION=database

CACHE_STORE=database

# OTP par email. Dev : Mailpit (infra/docker-compose.yml) → http://localhost:8025
# Production Hostinger : smtp.hostinger.com, port 465, MAIL_SCHEME=smtps
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
